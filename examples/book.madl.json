{
  "$schema": "https://raw.githubusercontent.com/Alexander-Aghili/Multi-Agent-Descriptor-Language/main/schema/draft/schema.json",
  "madl": "draft",
  "system": {
    "id": "book",
    "name": "Book",
    "description": "Writes a book chapter by chapter: drafts, a review panel, a check, a person's sign-off, then a merge."
  },
  "inputs": [
    {
      "id": "topic",
      "to": [
        "editor"
      ]
    }
  ],
  "agents": [
    {
      "id": "editor",
      "runtime": "claude-code"
    },
    {
      "id": "writer",
      "runtime": "claude-code"
    },
    {
      "id": "writer-2",
      "runtime": "claude-code"
    },
    {
      "id": "senior",
      "runtime": "claude-code",
      "model": "anthropic/claude-opus-5-5"
    },
    {
      "id": "critic",
      "runtime": "claude-code"
    },
    {
      "id": "fact-checker",
      "runtime": "codex"
    }
  ],
  "workflows": [
    {
      "id": "chapters",
      "input": "topic",
      "dispatcher": "editor",
      "entry": "draft",
      "collector": "editor",
      "max_items": 12,
      "max_steps": 20,
      "copies": "per-item",
      "stages": [
        {
          "id": "draft",
          "name": "Draft",
          "agent": "writer",
          "workers": [
            "writer-2"
          ],
          "routes": {
            "done": "review"
          },
          "max_rounds": 3,
          "on_limit": "sign-off",
          "escalate": {
            "after_rounds": 2,
            "to": "senior"
          }
        },
        {
          "id": "review",
          "reviewers": [
            "critic",
            "fact-checker"
          ],
          "personas": {
            "critic": "simplifier",
            "fact-checker": "expert"
          },
          "join": "all",
          "priority": [
            "blocked",
            "changes",
            "approved"
          ],
          "routes": {
            "approved": "verify",
            "changes": "draft"
          }
        },
        {
          "id": "verify",
          "kind": "check",
          "routes": {
            "failed": "draft",
            "passed": "sign-off"
          },
          "command": "make check",
          "timeout_s": 600
        },
        {
          "id": "sign-off",
          "kind": "human",
          "routes": {
            "no": "draft",
            "yes": "merge"
          },
          "prompt": "Publish this chapter?"
        },
        {
          "id": "merge",
          "kind": "merge",
          "routes": {
            "merged": null
          },
          "into": "main"
        }
      ]
    }
  ],
  "policies": {
    "guards": [
      {
        "command": "make health",
        "every": "10m"
      }
    ]
  },
  "layout": {
    "nodes": {
      "topic": {
        "x": -240.0,
        "y": 40.0
      }
    },
    "stages": {
      "chapters": {
        "draft": {
          "x": 300.0,
          "y": 40.0
        },
        "verify": {
          "x": 600.0,
          "y": 40.0
        }
      }
    }
  }
}
